# TRINITY environment template. Copy to .env and edit.
# Names must match backend/app/core/config.py (Settings) exactly.
ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Local (no Docker): use localhost. Docker Compose overrides host to 'db'/'redis'.
DATABASE_URL=postgresql+psycopg://trinity:trinity_dev_pw@localhost:5432/trinity
REDIS_URL=redis://localhost:6379/0

# Comma-separated, no spaces, no quotes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: USDA FoodData Central key enables live food search. Blank = seed DB only.
USDA_API_KEY=

# Frontend build-time variable (Vite). Read by frontend/src/lib/api.ts as VITE_API_BASE.
# Leave unset in dev (the Vite proxy forwards /api -> :8000). In production set the
# deployed API base, e.g. https://trinity-api.onrender.com/api/v1
VITE_API_BASE=
