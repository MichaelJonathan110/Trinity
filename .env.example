# TRINITY environment template. Copy to .env and edit.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local (no Docker): use localhost. Docker Compose overrides host to 'db'/'redis'.
DATABASE_URL=postgresql+psycopg://trinity:trinity_dev_pw@localhost:5432/trinity
REDIS_URL=redis://localhost:6379/0

# Optional: USDA FoodData Central key enables live food search. Blank = seed DB only.
USDA_API_KEY=

VITE_API_BASE_URL=http://localhost:8000/api/v1
